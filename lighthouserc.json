{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/ecografie.html",
        "http://localhost/ecografia-addome-superiore.html",
        "http://localhost/ecografia-tiroide.html",
        "http://localhost/contatti.html",
        "http://localhost/index-en.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "blockedUrlPatterns": [
          "*cloudflareinsights.com*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}
